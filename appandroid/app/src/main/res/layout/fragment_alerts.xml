<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:padding="16dp"
    tools:context=".ui.AlertsFragment">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚨 Alertas de Garrafón Vacío / Nivel Bajo"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1E293B" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:text="El personal debe acudir a reemplazar el vidón de agua inmediatamente para evitar desabasto."
        android:textSize="13sp"
        android:textColor="#64748B" />

    <TextView
        android:id="@+id/tv_empty_alerts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="✅ ¡Excelente! No hay alertas activas de garrafones vacíos."
        android:textSize="15sp"
        android:textColor="#2E7D32"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_alerts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:listitem="@layout/item_alert" />

</LinearLayout>
