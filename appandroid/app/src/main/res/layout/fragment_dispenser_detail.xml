<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".ui.DispenserDetailFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/iv_gauge"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:src="@android:drawable/ic_dialog_info"
                    app:tint="#0288D1" />

                <TextView
                    android:id="@+id/tv_detail_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    tools:text="Dispensador Principal" />

                <TextView
                    android:id="@+id/tv_detail_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp"
                    android:textColor="#64748B"
                    tools:text="📍 Piso 1 - Recepción Central" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_detail_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@android:color/white"
                    tools:text="Nivel OK (85%)" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_detail"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_marginTop="20dp"
                    app:trackCornerRadius="8dp"
                    app:trackThickness="14dp" />

                <TextView
                    android:id="@+id/tv_liters_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#0288D1"
                    tools:text="17.0 Litros de 20.0 Litros restantes" />

                <TextView
                    android:id="@+id/tv_sensores_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="13sp"
                    android:textColor="#64748B"
                    tools:text="📡 Distancia HC-SR04: 12.5 cm · ESP32-W001" />

                <!-- Control remoto de la bomba: escribe bomba_estado en Firebase,
                     el ESP32 la enciende/apaga vía listener en tiempo real -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🚰 Bomba / Válvula de agua"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#334155" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_bomba"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Encender" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta de alerta: roja (crítico <15%) o amarilla (cambio <20%) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_alert_change"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="2dp"
            app:strokeColor="#D32F2F"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_alert_change_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#B71C1C"
                    tools:text="🚨 Cambio URGENTE de bidón" />

                <TextView
                    android:id="@+id/tv_alert_change_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="13sp"
                    android:textColor="#64748B"
                    tools:text="Garrafón crítico (8%). El operario debe reemplazarlo de inmediato." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sección de Pruebas de Sensor IoT ESP32 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📡 Simular Lectura de Sensor ESP32"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#334155" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Desliza para cambiar la lectura del sensor de nivel en tiempo real y probar la alerta automatizada:"
                    android:textSize="12sp"
                    android:textColor="#64748B" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_level"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.0"
                    android:valueTo="100.0"
                    android:stepSize="5.0"
                    android:value="85.0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_simulate_empty"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Simular Vacío (0%)"
                        android:textColor="#D32F2F"
                        app:strokeColor="#D32F2F" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_simulate_low"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="Simular Bajo (20%)"
                        android:textColor="#F57C00"
                        app:strokeColor="#F57C00" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón Acción Principal: Registrar Cambio de Garrafón -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_refill_bottle"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="🔄 Registrar Cambio Manual de Garrafón"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            android:backgroundTint="#0288D1" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
